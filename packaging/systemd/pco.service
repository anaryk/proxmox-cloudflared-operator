[Unit]
Description=pco, Cloudflare Tunnel operator for Proxmox VE
Documentation=https://github.com/anaryk/proxmox-cloudflared-operator
After=network-online.target pve-cluster.service corosync.service pveproxy.service pco-netns.service
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/pco daemon
Restart=always
RestartSec=5
TimeoutStartSec=150
# The engine pings while its cycles make progress. One that hangs is
# restarted: the lease, kept beside it, would stay refreshed for good.
WatchdogSec=90s
RuntimeDirectory=pco
RuntimeDirectoryMode=0750
StateDirectory=pco
StateDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
ProtectProc=invisible
# The daemon holds the Cloudflare tokens in memory; no core dump keeps them.
LimitCORE=0

[Install]
WantedBy=multi-user.target
