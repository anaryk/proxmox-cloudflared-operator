  {"fn": "egressText", "name": "not checked yet", "input": {}, "want": "not checked yet"},
  {"fn": "egressText", "name": "on", "input": {"state": "on"}, "want": "on"},
  {"fn": "egressText", "name": "off", "input": {"state": "off", "since": "2026-10-05T09:00:00Z"}, "want": "off: the connectors are not confined"},
