  {"fn": "credentialState", "name": "a failed check", "input": {"id": "a1b2c3d4", "label": "main", "kind": "scoped", "checked": true, "report": {"token": {"id": "t1", "status": "active"}, "accounts": [], "zones": [], "checks": [{"capability": "token", "ok": true}, {"capability": "dns.read", "scope": "example.com", "scopeId": "zone1", "ok": false, "detail": "grant Zone > DNS > Read on example.com"}], "excluded": [], "deep": false, "usable": false, "leftovers": []}}, "want": "problem"},
  {"fn": "credentialState", "name": "a failed check next to one without an answer", "input": {"id": "a1b2c3d4", "label": "main", "kind": "scoped", "checked": true, "report": {"token": {"id": "t1", "status": "active"}, "accounts": [], "zones": [], "checks": [{"capability": "dns.read", "scope": "example.com", "scopeId": "zone1", "ok": false, "unanswered": true}, {"capability": "tunnel.read", "scope": "Main", "scopeId": "0123456789abcdef0123456789abcdef", "ok": false, "detail": "grant Account > Cloudflare Tunnel > Read"}], "excluded": [], "deep": false, "usable": false, "leftovers": []}}, "want": "problem"},

