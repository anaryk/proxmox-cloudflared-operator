dpkg-query --show --showformat=${db:Status-Want} ${db:Status-Status} ${db:Status-Eflag} ${Version} pco
dpkg-deb -x $WORK/previous/pco_1.2.3_amd64.deb $WORK/.extract-*
$WORK/.extract-*/usr/bin/pco version --json
apt-get install -y --allow-change-held-packages --allow-downgrades -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold $WORK/previous/pco_1.2.3_amd64.deb
apt-mark hold pco cloudflared
