add table inet pco_gw
delete table inet pco_gw
table inet pco_gw {
	map svc_zone {
		typeof ip daddr : ct zone
	}
	map svc_mark {
		typeof ip daddr : meta mark
	}
	map leg_zone {
		typeof iifname : ct zone
	}
	map svc_dnat {
		type ipv4_addr . inet_service : ipv4_addr . inet_service
	}
	map leg_snat {
		type ifname : interval ipv4_addr . inet_service
		flags interval
	}
	set legs {
		typeof iifname
	}
	set dhcp_legs {
		typeof iifname
	}
	set leg_ok {
		typeof oifname . ct zone
	}
	counter dropped_local {
	}
	counter dropped_oif {
	}
	counter dropped_leg_in {
	}
	chain out_raw {
		type filter hook output priority raw; policy accept;
		ip daddr 198.18.0.0/16 ct zone set ip daddr map @svc_zone
		ip daddr 198.18.0.0/16 meta mark set ip daddr map @svc_mark
		oifname @legs ct zone set oifname map @leg_zone
	}
	chain out_nat {
		type nat hook output priority dstnat; policy accept;
		ip daddr 198.18.0.0/16 meta l4proto tcp dnat ip to ip daddr . tcp dport map @svc_dnat
	}
	chain out_guard {
		type filter hook output priority filter; policy accept;
		ct status dnat fib daddr type local counter name "dropped_local" drop
	}
	chain post_filter {
		type filter hook postrouting priority filter; policy accept;
		ct status dnat oifname . ct zone != @leg_ok counter name "dropped_oif" drop
	}
	chain post_nat {
		type nat hook postrouting priority srcnat; policy accept;
		meta l4proto tcp oifname @legs snat ip to oifname map @leg_snat
	}
	chain pre_raw {
		type filter hook prerouting priority raw; policy accept;
		iifname @legs ct zone set iifname map @leg_zone
	}
	chain input {
		type filter hook input priority filter; policy accept;
		iif "lo" accept
		ct state established,related accept
		iifname @legs ct state invalid drop
		iifname @dhcp_legs udp dport 67 udp sport 68 accept
		iifname @legs counter name "dropped_leg_in" drop
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
	}
}
