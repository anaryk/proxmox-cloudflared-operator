add table inet pco_gw
delete table inet pco_gw
table inet pco_gw {
	map svc_zone {
		typeof ip daddr : ct zone
	}
	map svc_mark {
		typeof ip daddr : meta mark
	}
	map leg_zone {
		typeof iifname : ct zone
	}
	map svc_dnat {
		type ipv4_addr . inet_service : ipv4_addr . inet_service
	}
	map leg_snat {
		type ifname : interval ipv4_addr . inet_service
		flags interval
	}
	set allowed {
		typeof oifname . ip daddr . tcp dport
	}
	set legs {
		typeof iifname
	}
	set dhcp_legs {
		typeof iifname
	}
	set leg_ok {
		typeof oifname . ct zone
	}
	counter dropped_forward {
	}
	counter dropped_input {
	}
	counter dropped_leg_in {
	}
	counter dropped_transit {
	}
	counter dropped_oif {
	}
	chain pre_raw {
		type filter hook prerouting priority raw; policy accept;
		iifname "transit0" ip saddr != 198.18.0.1 counter name "dropped_transit" drop
		iifname "transit0" ct zone set ip daddr map @svc_zone
		iifname "transit0" meta mark set ip daddr map @svc_mark
		iifname @legs ct zone set iifname map @leg_zone
	}
	chain out_raw {
		type filter hook output priority raw; policy accept;
		oifname @legs ct zone set oifname map @leg_zone
	}
	chain pre_nat {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "transit0" ip saddr 198.18.0.1 meta l4proto tcp dnat ip to ip daddr . tcp dport map @svc_dnat
	}
	chain post_filter {
		type filter hook postrouting priority filter; policy accept;
		ct status dnat ct direction original oifname . ct zone != @leg_ok counter name "dropped_oif" drop
	}
	chain post_nat {
		type nat hook postrouting priority srcnat; policy accept;
		meta l4proto tcp oifname @legs snat ip to oifname map @leg_snat
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iifname "transit0" ip saddr 198.18.0.1 ct status dnat ct state new oifname . ip daddr . tcp dport @allowed accept
		counter name "dropped_forward"
	}
	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" accept
		ct state established,related accept
		ct state invalid drop
		iifname @dhcp_legs udp dport 67 udp sport 68 accept
		iifname @legs counter name "dropped_leg_in" drop
		counter name "dropped_input"
	}
}
